# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

BACKEND_URL=http://localhost:3000

# PoliNetwork IdP (optional while the backend accepts anonymous calls). Set all of these, or none:
# with none set, backend calls stay anonymous. IDP_INTERNAL_URL is optional.
# IDP_PUBLIC_URL=https://auth.polinetwork.org
# IDP_INTERNAL_URL=http://auth-service.auth.svc.cluster.local:3000
# OAUTH_BACKEND_RESOURCE_URI=https://backend.internal.polinetwork.org
# The ID the IdP generated for the `website` client.
# OAUTH_WEBSITE_CLIENT_ID=
# The `website` client's private signing key as a single-line JWK, with `kid` and `alg` (EdDSA).
# OAUTH_WEBSITE_PRIVATE_JWK=
