{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "build": "cross-env SKIP_ENV_VALIDATION=true next build",
    "dev": "cross-env PORT=3002 next dev",
    "preview": "pnpm build && pnpm start",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write --unsafe",
    "build:analyze": "cross-env SKIP_ENV_VALIDATION=true next experimental-analyze --output",
    "prestart": "mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/"
  },
  "dependencies": {
    "@polinetwork/backend": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "11.5.1",
    "@trpc/next": "11.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.5.1",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.6.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@trpc/server": "11.5.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.5.2"
  }
}
